{
  "name": "engineer-profile",
  "version": "0.3.0",
  "description": "Self-maintaining engineering portfolio from repository activity",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "engineer-profile": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && node dist/index.js demo",
    "ingest": "npm run build && node dist/index.js ingest",
    "publish": "npm run build && node dist/index.js publish",
    "capture": "npm run build && node dist/index.js capture",
    "deploy": "npm run build && node dist/index.js deploy",
    "refresh": "npm run build && node dist/index.js refresh"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "portfolio",
    "github",
    "changelog",
    "playwright",
    "engineering"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielCuevas1208/engineer-profile.git"
  },
  "bugs": {
    "url": "https://github.com/DanielCuevas1208/engineer-profile/issues"
  },
  "homepage": "https://github.com/DanielCuevas1208/engineer-profile#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.1.2",
    "playwright": "^1.50.1",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  }
}
